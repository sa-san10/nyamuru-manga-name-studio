---
import Layout from '../layouts/Layout.astro';

const migrationGuideUrl = 'https://github.com/sa-san10/nyamuru-manga-name-studio/blob/main/docs/migration-from-v1.3.md';

const releases = [
  {
    version: '1.8.1',
    code: 14,
    date: '2026-08-04',
    title: 'READMEリンク整備',
    changes: [
      'README：各ドキュメントの説明箇所にリポジトリ内の実ファイルへのリンクを追加（NDM仕様書・内蔵サンプル・生成プロンプト本体と解説・生成ワークフロー本体と解説・にゃむるたん設定書。英語版がある文書はENリンクを併記）',
    ],
  },
  {
    version: '1.8.0',
    code: 13,
    date: '2026-08-04',
    title: 'アンカー位置の可視化',
    changes: [
      'ネーム画面：人物・フキダシを選択すると、設定中のアンカー（コマ内の相対位置）を可視化。コマ内の想定位置に黄色い丸マーカーを置き、要素の中心から破線でつなぎ、マーカーの上にアンカー種別名を半透明ラベルで表示（アンカー未指定の要素では表示なし）',
    ],
  },
  {
    version: '1.7.1',
    code: 12,
    date: '2026-08-04',
    title: 'モバイル表示の修正',
    changes: [
      'モバイル表示のフッターにライセンス表記とバージョン履歴リンクを表示（オフライン案内のみ非表示に）',
      'ドキュメント記事内の折り返せない長い語句（スラッシュ区切りの語彙列など）を折り返すようにし、生成プロンプトタブで横スクロールが発生する問題を修正',
      'スタンドアロン版の「使い方」タブに、最新版の配布元（GitHubリポジトリ）へのリンクを表示',
    ],
  },
  {
    version: '1.7.0',
    code: 11,
    date: '2026-07-31',
    title: '生成プロンプトv10.3：人物センター原則で右寄りを防止',
    changes: [
      '生成プロンプトをv10.3に更新：人物センター原則を追加——動きの演出のない通常の会話コマでは人物をコマ中央領域に大きく置き（中心ズレはコマ幅の±5%以内・高さはコマの9割前後）、フキダシは読み順を保ったまま人物の右→左に振り分ける。人物がコマ右側へ寄り、ページ全体が右重心になる問題を防ぐ',
      'フキダシと顔ゾーンの交差回避は、人物を動かさずフキダシ側を退避させる運用に。OMNY出力後の自己検証に人物センター原則の遵守状況（人物中心ズレ±5%チェック・ページの面積重心チェック）の報告を追加',
      '発言順＝立ち位置の規則はfiguresを省略したコマ専用のフォールバックであることを明記（figuresのbbox/anchorを明示したコマではそちらが常に優先）',
    ],
  },
  {
    version: '1.6.0',
    code: 10,
    date: '2026-07-30',
    title: 'フキダシ尻尾の運用整理と作品別OMAY',
    migrationGuide: true,
    changes: [
      '生成ワークフローからフキダシ尻尾の描画抑制指示を削除。尻尾はOMAYの指定（話者の口元へ向ける）どおり画像生成時に描画し、人間の後工程はフキダシ内テキスト校正と尻尾の検品に',
      '生成ワークフロー・READMEに作品別OMAYの参照ルールを追加：(作品名).omny.yaml と同じ作品名の (作品名).omay.yaml があればその作品に適用し、無ければ standard.omay.yaml を使用',
      '生成プロンプトから画像生成側の運用指示（文字は作画と同時に生成・後写植禁止の項）を削除し、bg:-1 の説明も画像生成の詳細に踏み込まない記述に整理',
      '生成プロンプトタブ：OMAY標準テンプレートの案内を「使い方」の手順内へ移動し、コピー・保存ボタンを作品情報ページへの誘導リンクに変更',
      '作品情報タブ：標準テンプレートを standard.omay.yaml として保存するボタンを追加',
      '旧バージョンから更新して初めて開いたとき、v1.3.x からの移行ガイドへ誘導する案内を1回だけ表示（初回訪問でウェルカム案内が出る場合は表示しない）',
    ],
  },
  {
    version: '1.5.0',
    code: 9,
    date: '2026-07-30',
    title: '画像生成指示（OMAY）の分離',
    migrationGuide: true,
    changes: [
      '作画・演出ルールとレイアウト仕様を、画像生成指示ファイルOMAY（Open Manga Artwork YAML・standard.omay.yaml）へ分離。画像生成側のプロジェクト指示に一度設定すれば、作品ごとに渡すのはOMNYのみになり、生成のたびに定型ルールを転記出力するトークン浪費と転記変異をなくした',
      '生成プロンプトを純粋なネームデータ（OMNY）のみの出力に変更。meta.style_notesは作品固有の作画指示（画風の行など）専用に',
      '作品情報タブに「画像生成指示（OMAY）」セクションを新設：標準テンプレート読み込み（上書き確認あり）・OMAYファイル読み込み・OMAYファイル書き出しの3操作',
      'ヘッダーの「OMNY保存」を2種類に：画像生成指示分離版（.omny.yaml・純粋なネームデータ）と全部入り版（.yaml・ルール込み）。全部入り版は分離版＋ルールの合成として生成',
      '生成プロンプトタブにOMAY標準テンプレートの個別コピー・保存導線を追加',
      '生成ワークフローをOMAY＋OMNYの2ファイル入力構成に更新：spec_versionとschema_versionの対応確認、OMAY未提供時は推測せず不足報告',
      'サンプル漫画『押しかけ妖精にゃむるたん』のstyle_notes・layout_specを標準OMAYと同一内容に更新（サンプル固有の版権配慮ルールは維持）',
      'NDM仕様・各READMEの英語版もOMAY分離の内容に追随',
    ],
  },
  {
    version: '1.4.0',
    code: 8,
    date: '2026-07-30',
    title: 'NDM v10.2：背景無描画 bg:-1 と配置規則の一本化',
    migrationGuide: true,
    changes: [
      'NDMスキーマ・生成プロンプトをv10.2に更新',
      'bgに-1（背景無描画）を追加：後工程で背景を差し替えるコマ向けに、中間グレー1色のベタ塗り・接地影なしで作画する指定。依頼で指示したコマにのみ使い、演出判断では自動選択しない。ネーム画面のBG選択とNDM検査もbg:-1に対応',
      '配置の優先順位（action＞anchor＞発言順＝立ち位置＞size＞bbox）を生成プロンプト§Cの表へ一本化し、anchor（フキダシのしっぽ向き推定の基準）・bbox（面積確保とかぶり防止）など各フィールドの役割を明記',
      '読み順の正はbubblesの配列順のみと明確化（anchorとbboxは配置のみを指す）',
      'NDM仕様・生成プロンプトREADMEの英語版もv10.2の内容に追随',
    ],
  },
  {
    version: '1.3.0',
    code: 7,
    date: '2026-07-27',
    title: '見開き表示とページ並べ替え',
    changes: [
      'ネーム画面に「見開き」ボタンを追加：2ページを右綴じの見開きで並べて表示。相方ページはクリックで編集対象に切り替え（スマホ等の狭い画面では単ページ表示のまま）',
      'ページ一覧のドラッグ＆ドロップでページ順を入れ替え可能に。ページ番号とOMNYのpage・page_countも自動で振り直し',
      'READMEに简体中文サマリと公式マスコット「にゃむるたん」の紹介を追加',
    ],
  },
  {
    version: '1.2.0',
    code: 6,
    date: '2026-07-27',
    title: 'コマ割り4種追加と生成プロンプトv10.1',
    changes: [
      'コマ割りパターンR〜U（斜め・多角形コマ系）を追加：斜め4段タタミカケ／対決ツイン／クサビ畳みかけ／斜めメクリドン',
      '生成プロンプトをv10.1に更新：冒頭に作品情報の記入欄（タイトル・作者名・作風・雰囲気・画風）を新設。画風は少女漫画・週刊少年漫画・劇画などを自由記述で指定でき、作風との掛け合わせも可能',
      '生成プロンプト：OMNY本体の提供方法をLLM別に指定（ChatGPT=実ファイル＋ダウンロードリンク／Claude=アーティファクト／Gemini=コードブロック）',
      'READMEにメイン画面・サンプルネーム・完成漫画のスクリーンショット3点を追加し、英語サマリを箇条書きに再構成',
    ],
  },
  {
    version: '1.1.0',
    code: 5,
    date: '2026-07-27',
    title: 'ドキュメント英語版とJP/EN切り替え',
    changes: [
      '生成プロンプト・生成ワークフロー・NDM仕様・にゃむるたんの各タブにJP/EN言語切り替えを追加（選択した言語は端末に保存）',
      'NDM仕様、生成ワークフロー本体、各タブの説明文書、にゃむるたんキャラクター設定の英語版を収録（完全版プロンプトとサンプルOMNYは日本語のまま）',
      'READMEの冒頭に英語サマリを追加',
    ],
  },
  {
    version: '1.0.3',
    code: 4,
    date: '2026-07-24',
    title: 'インストール追修正と起動高速化',
    changes: [
      'ホーム画面インストールの追修正：アプリ表示に切り替わった後もPWAとして認識されるようにし、インストールしたアイコンから確実に起動できるように（GitHub Pages版）',
      'アプリ起動を高速化：本体をキャッシュから即時起動し、更新は裏で取得して次回起動時に反映（GitHub Pages版）',
    ],
  },
  {
    version: '1.0.2',
    code: 3,
    date: '2026-07-24',
    title: 'ホーム画面インストール修正',
    changes: [
      'GitHub Pages版を正規のPWA化：manifestとservice workerを配信し、ホーム画面にインストールしたアイコンから起動できない問題を修正',
      'GitHub Pages版のオフライン起動に対応（アプリ本体をキャッシュし、更新はオンライン時に自動取得）',
    ],
  },
  {
    version: '1.0.1',
    code: 2,
    date: '2026-07-24',
    title: '紙面編集オーバーホール',
    changes: [
      '紙面ズーム：スマホの二本指ピンチで拡大縮小・視点移動、PCはCtrl+ホイール、右下にズームボタン。拡大すると文字も一緒に拡大',
      'コマ操作：多角形コマの頂点をドラッグで個別編集、PANELラベルをドラッグでコマ移動、ハンドルの大型化と当たり判定拡大',
      'コマ選択の表示を塗りつぶしから辺のハイライトに変更、PANELラベルは常にコマ左上の外側に',
      '多角形コマで枠線が切れる問題を修正（枠線をSVG描画に一新）',
      'フキダシ：文字サイズを2倍にし、はみ出す場合は自動縮小。文字背景に半透明の白マットを追加',
      'フキダシの形状をボックスいっぱいに描画（余白除去）、whisperを点線に、手描き文字に余白を追加',
      '人物/オブジェクトボックス：枠を太めの実線に、名前を2倍サイズ+収まらない場合は自動縮小',
      'コマ割りパターンEの中段に生じていた隙間を修正（生成プロンプトの座標も同期）',
      '案内ポップアップ：サンプル漫画をタップで全画面表示（タップでページ送り）、「創作パートナーのAIに聞いてみる」コピペ欄を新設',
      '使い方ページ：先頭に「AIに聞いてみる」欄、フロー図に「作業の流れ」タイトルを追加',
      'GitHub Pages版：読み込みページにOGP・favicon・サイト説明メタデータを追加',
    ],
  },
  {
    version: '1.0.0',
    code: 1,
    date: '2026-07-22',
    title: '初回リリース',
    changes: [
      'ネーム編集：コマ割り・人物・フキダシをドラッグで配置調整、コマ割りパターン適用、アンドゥ／リドゥ',
      '作品情報・舞台設定・登場人物・素材の各エディタ',
      'OMNY編集：YAMLの直接編集・整形・反映',
      'NDM検査：Nyamuru Data Model v10のルールに沿った自動チェック',
      '使い方ガイド：LLM→調整→画像生成AIの3ステップワークフロー案内と初回案内ポップアップ',
      '漫画ネーム生成プロンプト・エージェント生成ワークフロー・NDM仕様の閲覧とダウンロード',
      '公式マスコット「にゃむるたん」ページ（キャラクター設定・立ち絵素材、CC BY 4.0）',
      'サンプル漫画『押しかけ妖精にゃむるたん』を収録',
      'PWA対応：オフライン動作・編集内容の端末内自動保存',
      'スタンドアロン版（単一HTMLファイル）の同梱配信とダウンロードボタン',
      'URLの ?tab= 指定で任意のタブを直接開けるディープリンク',
    ],
  },
];
---

<Layout title="バージョン履歴 | Nyamuru🐱Manga Name Studio" description="Nyamuru🐱Manga Name Studioのバージョン履歴・更新内容">
  <main class="changelog-page">
    <nav><a href="/">← アプリへ戻る</a></nav>
    <header>
      <span>VERSION HISTORY</span>
      <h1>バージョン履歴</h1>
      <p><strong>Nyamuru🐱Manga Name Studio</strong>のリリースごとの更新内容です。</p>
    </header>

    {releases.map((release) => (
      <section>
        <div class="release-head">
          <h2>v{release.version}</h2>
          <span class="release-title">{release.title}</span>
          <span class="release-code">バージョンコード {release.code}</span>
          <time datetime={release.date}>{release.date}</time>
        </div>
        <ul>
          {release.changes.map((change) => <li>{change}</li>)}
        </ul>
        {release.migrationGuide && (
          <p class="migration-link">
            <a href={migrationGuideUrl}>→ v1.3.x からの移行ガイド（変更内容と対応作業）</a>
          </p>
        )}
      </section>
    ))}
  </main>
</Layout>

<style>
  :global(body) { overflow: auto; }
  .changelog-page { width: min(860px, calc(100% - 32px)); margin: 0 auto; padding: 32px 0 64px; }
  nav { margin-bottom: 32px; }
  a { color: #d94661; font-weight: 700; text-decoration: none; }
  a:hover { text-decoration: underline; }
  header { padding: 30px; border: 1px solid #f0d9df; border-radius: 18px; background: linear-gradient(135deg, #fff0f3, #f0f8ff); }
  header span { color: #e64f68; font: 800 10px/1 monospace; letter-spacing: .16em; }
  h1 { margin: 10px 0 12px; font-size: clamp(26px, 5vw, 42px); }
  p { margin: 0; color: #606572; line-height: 1.85; }
  section { margin-top: 20px; padding: 24px; border: 1px solid #f0e5e8; border-radius: 14px; background: rgba(255,255,255,.96); }
  .release-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px; margin-bottom: 10px; }
  h2 { margin: 0; font-size: 22px; color: #d94661; }
  .release-title { color: #47434c; font-size: 14px; font-weight: 800; }
  .release-code { padding: 3px 8px; border: 1px solid #f0d9df; border-radius: 999px; color: #a08a92; font: 700 10px/1 ui-monospace, monospace; }
  time { margin-left: auto; color: #7b8190; font: 700 11px/1 ui-monospace, monospace; }
  ul { margin: 0; padding-left: 22px; }
  .migration-link { margin: 12px 0 0; font-size: 13px; }
  li { margin: 6px 0; color: #5e5a64; line-height: 1.75; }
  @media (max-width: 560px) {
    .changelog-page { width: min(100% - 20px, 860px); padding-top: 20px; }
    header, section { padding: 18px; }
  }
</style>
